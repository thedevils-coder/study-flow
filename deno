#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
DENO_EXE="$ROOT/.tools/bin/deno"
if [[ ! -x "$DENO_EXE" ]]; then
  node "$ROOT/scripts/install-deno.cjs"
fi
if [[ ! -x "$DENO_EXE" ]]; then
  echo "Deno is not installed. Run npm install in the project root." >&2
  exit 1
fi
exec "$DENO_EXE" "$@"
