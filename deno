#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
if [[ -x "$ROOT/node_modules/deno/deno" ]]; then
  exec "$ROOT/node_modules/deno/deno" "$@"
fi
if [[ -x "$ROOT/node_modules/.bin/deno" ]]; then
  exec "$ROOT/node_modules/.bin/deno" "$@"
fi
echo "Deno is not installed. Run npm install in the project root." >&2
exit 1
