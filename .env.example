# Mobile client configuration. Values with EXPO_PUBLIC_ are visible in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=basic

# Preview/development tester account. Not used in production EAS builds.
# EXPO_PUBLIC_TESTER_EMAIL=tester@getstudyflow.in
# EXPO_PUBLIC_TESTER_PASSWORD=StudyFlow-Tester-Preview
#
# EXPO_PUBLIC_SUPABASE_URL must be the project URL, for example:
# https://<project-ref>.supabase.co
# Do not append /rest/v1/

# Never add these values to this file or the mobile app. Set them as Supabase
# Edge Function secrets:
# SUPABASE_SERVICE_ROLE_KEY
# REVENUECAT_WEBHOOK_SECRET
# AI_API_KEY
# AI_API_URL
# AI_MODEL
# REVENUECAT_SECRET_API_KEY
