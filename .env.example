# Client configuration. Values with EXPO_PUBLIC_ are visible in the app bundle.
# Copy this file to `.env.local` or `.env` for local web (`npx expo start --web`)
# and production web export (`npm run web:export` / `npx expo export --platform web`).
# Expo loads, in order: .env.[mode].local, .env.local, .env.[mode], .env (shell wins).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Preview/development tester account. Not used in production EAS builds.
# EXPO_PUBLIC_TESTER_EMAIL=tester@getstudyflow.in
# EXPO_PUBLIC_TESTER_PASSWORD=StudyFlow-Tester-Preview
#
# EXPO_PUBLIC_SUPABASE_URL must be the project URL, for example:
# https://<project-ref>.supabase.co
# Do not append /rest/v1/

# Public AdMob IDs. Production Android values live in eas.json
# build.production.env. Development/preview always use Google official
# test IDs and ignore production values.
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=
# EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_UNIT_ID=
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=
# EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_UNIT_ID=

# Never add these values to this file or the mobile app. Set them as Supabase
# Edge Function secrets:
# SUPABASE_SERVICE_ROLE_KEY
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
# GOOGLE_PLAY_PACKAGE_NAME
# GOOGLE_PLAY_RTDN_SECRET
# AI_API_KEY
# AI_API_URL
# AI_MODEL
