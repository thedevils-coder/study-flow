# Mobile client configuration. Values with EXPO_PUBLIC_ are visible in the app.
# Supabase: Project Settings > API > Project URL / Publishable key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# RevenueCat: Project Settings > API Keys > App-specific public SDK key.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Optional. Default entitlement fallback is `premium` (legacy Basic). Prefer `basic` + `pro`.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# Never add these values to this file or the mobile app. Set them as Supabase
# Edge Function secrets: SUPABASE_SERVICE_ROLE_KEY, REVENUECAT_WEBHOOK_SECRET,
# AI_API_KEY, and (only if server API calls are needed) REVENUECAT_SECRET_API_KEY.
